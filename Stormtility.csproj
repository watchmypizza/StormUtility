<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BergamotTranslatorSharp" Version="0.3.4" />
    <PackageReference Include="DiscordRichPresence" Version="1.143.0" />
    <PackageReference Include="DSharpPlus" Version="5.0.0-nightly-02596" />
    <PackageReference Include="DSharpPlus.CommandsNext" Version="5.0.0-nightly-02596" />
    <PackageReference Include="DSharpPlus.Commands" Version="5.0.0-nightly-02596" />
    <PackageReference Include="DSharpPlus.Interactivity" Version="5.0.0-nightly-02596" />
    <PackageReference Include="DSharpPlus.SlashCommands" Version="5.0.0-nightly-02596" />
    <PackageReference Include="GTranslate" Version="2.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="XeroxDev.DSharpPlus.ModalCommands" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Tsk">
    	<HintPath>libs/tsk.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="config\config.json" />
    <Content Remove="config\jobs.json" />
    <Content Remove="activetickets.json" />
    <Content Remove="*.db" />
    <Content Remove="*.json" />
  </ItemGroup>

  <ItemGroup>
  	<Content Include="Assets/**">
   	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Banners\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TranscriptServer\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="commands\Utility\" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="config\blacklists.json" />
    <None Remove="config\mutecounter.json" />
    <None Remove="config\tickets.json" />
    <None Remove="config\transcripts.json" />
  </ItemGroup>
</Project>
